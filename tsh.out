./sdriver.pl -t trace01.txt -s ./tsh -a "-p"
#
# trace01.txt - Properly terminate on EOF.
#
./sdriver.pl -t trace02.txt -s ./tsh -a "-p"
#
# trace02.txt - Process builtin quit command.
#
./sdriver.pl -t trace03.txt -s ./tsh -a "-p"
#
# trace03.txt - Run a foreground job.
#
tsh> quit
./sdriver.pl -t trace04.txt -s ./tsh -a "-p"
#
# trace04.txt - Run a background job.
#
tsh> ./myspin 1 &
[1] (1379963) ./myspin 1 &
./sdriver.pl -t trace05.txt -s ./tsh -a "-p"
#
# trace05.txt - Process jobs builtin command.
#
tsh> ./myspin 2 &
[1] (1379968) ./myspin 2 &
tsh> ./myspin 3 &
[2] (1379970) ./myspin 3 &
tsh> jobs
[1] (1379968) Running ./myspin 2 &
[2] (1379970) Running ./myspin 3 &
./sdriver.pl -t trace06.txt -s ./tsh -a "-p"
#
# trace06.txt - Forward SIGINT to foreground job.
#
tsh> ./myspin 4
Job [1] (1379977) terminated by signal 2
./sdriver.pl -t trace07.txt -s ./tsh -a "-p"
#
# trace07.txt - Forward SIGINT only to foreground job.
#
tsh> ./myspin 4 &
[1] (1379982) ./myspin 4 &
tsh> ./myspin 5
Job [2] (1379984) terminated by signal 2
tsh> jobs
[1] (1379982) Running ./myspin 4 &
./sdriver.pl -t trace08.txt -s ./tsh -a "-p"
#
# trace08.txt - Forward SIGTSTP only to foreground job.
#
tsh> ./myspin 4 &
[1] (1379990) ./myspin 4 &
tsh> ./myspin 5
Job [2] (1379992) stopped by signal 20
tsh> jobs
[1] (1379990) Running ./myspin 4 &
[2] (1379992) Stopped ./myspin 5 
./sdriver.pl -t trace09.txt -s ./tsh -a "-p"
#
# trace09.txt - Process bg builtin command
#
tsh> ./myspin 4 &
[1] (1379999) ./myspin 4 &
tsh> ./myspin 5
Job [2] (1380001) stopped by signal 20
tsh> jobs
[1] (1379999) Running ./myspin 4 &
[2] (1380001) Stopped ./myspin 5 
tsh> bg %2
[2] (1380001) ./myspin 5 
tsh> jobs
[1] (1379999) Running ./myspin 4 &
[2] (1380001) Running ./myspin 5 
./sdriver.pl -t trace10.txt -s ./tsh -a "-p"
#
# trace10.txt - Process fg builtin command. 
#
tsh> ./myspin 4 &
[1] (1380009) ./myspin 4 &
tsh> fg %1
Job [1] (1380009) stopped by signal 20
tsh> jobs
[1] (1380009) Stopped ./myspin 4 &
tsh> fg %1
tsh> jobs
